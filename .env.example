# Pathways Discovery App - environment template.
# Copy to .env.local for local development. Never commit a real .env file.
# Every value below is a placeholder; see src/env.ts for validation rules.

NODE_ENV=development

# Local/test PostgreSQL only in Phase 1. Never a production connection
# string -- see docs/pathways/INTEGRATION_REGISTER.md.
DATABASE_URL=postgresql://pathways_app:REPLACE_ME@localhost:5432/pathways_dev

# A SEPARATE database used only by `pnpm test` (integration tests),
# so a test run can never read or write dev data. Only consumed by
# scripts/test-db-setup.ts and tests/, not by src/env.ts.
TEST_DATABASE_URL=postgresql://pathways_app:REPLACE_ME@localhost:5432/pathways_test

# Better Auth groundwork. Generate a real 32+ character secret locally,
# e.g. `openssl rand -base64 32`. Never reuse this example value.
BETTER_AUTH_SECRET=REPLACE_ME_WITH_A_GENERATED_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=http://localhost:3000

# Integration modes. Only the values implemented so far are accepted;
# see src/env.ts. Changing these does not activate a feature that
# hasn't been built -- it only changes what honest state is reported.
EMAIL_MODE=UNCONFIGURED
SCHEDULER_MODE=UNCONFIGURED
AI_MODE=DISABLED

# Local/test-only fixture flag. Must be "false" (or unset) outside a
# local/test environment; the app refuses to start in production if
# this is "true".
ALLOW_TEST_FIXTURES=false

# Deployment/operating mode -- separate from NODE_ENV. A production
# BUILD can still be a non-live PREVIEW deployment. Only "LIVE" may
# ever collect real guest/family data, and LIVE requires the two
# settings below to be set explicitly (see src/env.ts). Leave this as
# LOCAL for everyday development.
DEPLOYMENT_MODE=LOCAL

# Illustrative development/test value ONLY -- 60 minutes. This is NOT
# an approved production retention or session policy; see
# docs/pathways/DECISION_LOG.md section D. DEPLOYMENT_MODE=LIVE
# requires this to be set explicitly; LOCAL/PREVIEW use this as a
# convenience default if left unset. Bounds: 5 to 44640 (31 days).
GUEST_SESSION_TTL_MINUTES=60

# Must be explicitly "true" for DEPLOYMENT_MODE=LIVE to start at all.
# This is a single acknowledgment switch, not the actual approval
# process -- it exists so LIVE mode can never be reached by a missing
# or default value. Leave "false" outside a genuinely approved live
# deployment.
LIVE_DEPLOYMENT_APPROVED=false
